#!/usr/bin/osascript -l JavaScript
// tts - read a text aloud into an audio file with the Mac's own voices, Siri voices included.
// The engine of the TTS app (github.com/geragarazagh/tts) and a command line tool of its own; everything
// is a flag. Built into macOS: osascript, AVFoundation, NaturalLanguage, afconvert. Optional: ffmpeg
// (Homebrew) for mp3.
//
//   tts [-v VOICE] [-r SPEED] [-p PITCH] [-l LANG] [-f FORMAT] [-o PATH] [-n NAME] FILE|-
//   tts -t [-l LANG] FILE|-        print the text as it will be read (language per paragraph), no audio
//   tts -L [LANG]                  list the voices
//   tts --serve                    the app's worker: JSON requests on stdin (see serve())
//
// Why osascript (2026-11-10, measured on macOS 27.2 and a clean 26.6.2): macOS gives Siri voices
// (Russian Voice 1 = Aleksei, Voice 2 = Yelena, Siri of other languages) only to Apple-signed
// processes. osascript is one and ships with every Mac; a binary we compile is not, and `swift
// file.swift` needs the developer tools (0.9 GB download).
'use strict';
ObjC.import('Foundation');
ObjC.import('AVFoundation');
ObjC.import('NaturalLanguage');
ObjC.import('stdlib');

// ---------------------------------------------------------------- small helpers

var FM = $.NSFileManager.defaultManager;
function say(fh, s) { fh.writeData($(s + '\n').dataUsingEncoding($.NSUTF8StringEncoding)); }
function out(s) { say($.NSFileHandle.fileHandleWithStandardOutput, s); }
function warn(s) { say($.NSFileHandle.fileHandleWithStandardError, 'tts: ' + s); }
function die(s) { warn(s); cleanup(); $.exit(1); }
function exists(p) { return FM.fileExistsAtPath(p); }
function rm(p) { if (exists(p)) FM.removeItemAtPathError(p, null); }
function readText(p) {
  var s = $.NSString.stringWithContentsOfFileEncodingError(p, $.NSUTF8StringEncoding, null);
  if (s.isNil()) s = $.NSString.stringWithContentsOfFileUsedEncodingError(p, null, null);
  if (s.isNil()) s = $.NSString.stringWithContentsOfFileEncodingError(p, 11, null);   // Windows-1251
  return s.isNil() ? null : s.js;
}
function writeText(p, s) { $(s).writeToFileAtomicallyEncodingError(p, true, $.NSUTF8StringEncoding, null); }
function env(k) { var v = $.NSProcessInfo.processInfo.environment.objectForKey(k); return v.isNil() ? '' : v.js; }
function sh(path, args) {        // runs a program, returns [status, stderr]
  var t = $.NSTask.alloc.init, p = $.NSPipe.pipe;
  t.executableURL = $.NSURL.fileURLWithPath(path);
  t.arguments = $(args);
  t.standardOutput = $.NSFileHandle.fileHandleWithNullDevice;
  t.standardError = p;
  if (!t.launchAndReturnError(null)) return [-1, 'cannot start ' + path];
  var d = p.fileHandleForReading.readDataToEndOfFile;
  t.waitUntilExit;
  return [t.terminationStatus, $.NSString.alloc.initWithDataEncoding(d, $.NSUTF8StringEncoding).js || ''];
}
function which(name) {
  var dirs = (env('PATH') + ':/opt/homebrew/bin:/usr/local/bin').split(':');
  for (var i = 0; i < dirs.length; i++) if (dirs[i] && FM.isExecutableFileAtPath(dirs[i] + '/' + name)) return dirs[i] + '/' + name;
  return null;
}
function clock(s) {
  s = Math.round(s);
  var h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = s % 60;
  return (h ? h + ':' + (m < 10 ? '0' : '') : '') + m + ':' + (x < 10 ? '0' : '') + x;
}
var TMP = null;
function cleanup() { if (TMP) rm(TMP); TMP = null; }

// ---------------------------------------------------------------- voices

// Rank: Siri first (the voices of System Settings > Accessibility > Spoken Content > Voice N),
// then Apple's premium, enhanced, compact. Novelty and Eloquence voices are left out.
function score(v) {
  var id = v.id;
  if (/speech\.synthesis\.voice|eloquence|personalvoice/.test(id)) return -1;
  if (/gryphon-neural/.test(id)) return 410;
  if (/siri/.test(id)) return 405;
  if (/gryphon/.test(id)) return 400;
  if (v.quality >= 3) return 300;
  if (v.quality == 2) return 200;
  if (/super-compact/.test(id)) return 50;
  return 100;
}
function kind(v) { var s = score(v); return s >= 400 ? 'Siri' : s >= 300 ? 'premium' : s >= 200 ? 'enhanced' : 'compact'; }
// language code of a voice as the language detector names it
function vcode(lang) {
  if (/^zh-(TW|HK)/.test(lang)) return 'zh-Hant';
  if (/^zh/.test(lang)) return 'zh-Hans';
  return lang.split('-')[0];
}
// the region Apple itself treats as the language's main one
var HOME = { en: 'US', es: 'ES', pt: 'BR', fr: 'FR', de: 'DE', ar: '001', nl: 'NL', it: 'IT' };
var VOICES = null;
function voices() {
  if (VOICES) return VOICES;
  var a = $.AVSpeechSynthesisVoice.speechVoices, r = [];
  for (var i = 0; i < a.count; i++) {
    var x = a.objectAtIndex(i);
    var v = { id: x.identifier.js, name: x.name.js, lang: x.language.js, gender: Number(x.gender), quality: Number(x.quality) };
    v.code = vcode(v.lang); v.score = score(v);
    // listed but not there: a clean macOS 26 lists a super-compact Milena that voiceWithIdentifier cannot
    // open (measured 2026-11-10 in the TTS app's test machine); such a voice would read nothing
    if (v.score > 0 && !$.AVSpeechSynthesisVoice.voiceWithIdentifier(v.id).isNil()) r.push(v);
  }
  r.sort(function (a, b) {
    return b.score - a.score || (b.lang.split('-')[1] == HOME[b.code]) - (a.lang.split('-')[1] == HOME[a.code]) || (b.gender == 2) - (a.gender == 2);
  });
  return (VOICES = r);
}
// best voice of a language for a gender (1 male, 2 female); the gender wins only within one
// quality tier of the best voice, so «male» never falls to a robot from 2005 when a Siri voice exists
function best(code, gender) {
  var c = voices().filter(function (v) { return v.code == code; });
  if (!c.length) return null;
  var g = c.filter(function (v) { return v.gender == gender; })[0];
  return g && g.score >= c[0].score - 100 ? g : c[0];
}
function findVoice(q) {
  q = q.toLowerCase();
  var all = voices();
  return all.filter(function (v) { return v.id.toLowerCase() == q; })[0] ||
    all.filter(function (v) { return v.name.toLowerCase() == q || v.id.toLowerCase().indexOf(q) >= 0; })[0] || null;
}
function listVoices(code) {
  var vs = voices().filter(function (v) { return !code || v.code == code || v.lang.toLowerCase().indexOf(code.toLowerCase()) == 0; });
  var picks = {};
  vs.forEach(function (v) { [1, 2].forEach(function (g) { var b = best(v.code, g); if (b) picks[b.id] = (picks[b.id] || '') + (g == 1 ? 'm' : 'f'); }); });
  var pad = function (s, n) { s = String(s); while (s.length < n) s += ' '; return s; };
  vs.sort(function (a, b) { return a.lang < b.lang ? -1 : a.lang > b.lang ? 1 : b.score - a.score; });
  vs.forEach(function (v) {
    var p = picks[v.id] ? (picks[v.id].indexOf('f') >= 0 ? 'female' : '') + (picks[v.id] == 'mf' || picks[v.id] == 'fm' ? '+' : '') + (picks[v.id].indexOf('m') >= 0 ? 'male' : '') : '';
    out(pad(v.lang, 7) + pad(v.name, 20) + pad(v.gender == 1 ? 'male' : v.gender == 2 ? 'female' : '-', 7) + pad(kind(v), 9) + pad(p, 12) + v.id);
  });
  if (!vs.length) out('no voices' + (code ? ' for ' + code : ''));
}

// ---------------------------------------------------------------- language of a paragraph

var UKW = /(^|[^\p{L}])(це|та|що|як|але|дуже|якщо|коли|вони|його|її|від|для|при|між|або|ще|вже|також|тому|лише|навіть|було|буде|має|можна|який|яка|яке|які)(?![\p{L}])/giu;
var RUW = /(^|[^\p{L}])(это|что|как|но|если|когда|они|только|уже|очень|его|её|для|при|между|или|ещё|также|поэтому|лишь|даже|было|будет|есть|можно|который|которая|которое|которые)(?![\p{L}])/giu;
function detect(par) {
  var letters = (par.match(/\p{L}/gu) || []).length;
  if (!letters) return null;
  var cyr = (par.match(/[Ѐ-ӿ]/g) || []).length, lat = (par.match(/[A-Za-z]/g) || []).length;
  if (cyr && cyr >= lat * 0.5) {
    // Russian text with English words stays Russian: one voice per paragraph (the author's Spoken Content
    // rule: one Siri voice for ru and en, language detection off)
    var uk = (par.match(/[іїєґІЇЄҐ]/g) || []).length * 2 + (par.match(UKW) || []).length;
    var ru = (par.match(/[ыэъёЫЭЪЁ]/g) || []).length * 2 + (par.match(RUW) || []).length;
    if (uk > ru) return 'uk';
    if (ru > 0 || !/[ґєії]/i.test(par)) {
      if (ru > 0) return 'ru';
    }
    var r = $.NLLanguageRecognizer.alloc.init;
    r.languageConstraints = $(['ru', 'uk', 'bg', 'sr', 'be', 'kk', 'mk']);
    r.processString(par);
    var l = r.dominantLanguage;
    return l.isNil() ? 'ru' : l.js;
  }
  // a short Latin line inside a Russian text (a name, a title) keeps the voice it is among
  if (lat >= letters * 0.8 && (par.match(/\p{L}+/gu) || []).length < 4) return null;
  var rec = $.NLLanguageRecognizer.alloc.init;
  rec.processString(par);
  var d = rec.dominantLanguage;
  return d.isNil() ? null : d.js;
}

